# Wajib di produksi: string acak panjang (min. 32 karakter) untuk menandatangani sesi.
# Buat dengan: openssl rand -base64 48
VITE_AUTH_SECRET=ganti-dengan-string-acak-panjang

# Ekstraksi AI lewat Amazon Bedrock. Kosongkan BEDROCK_MODEL_ID untuk memakai ekstraksi simulasi
# (tanpa kredensial AWS), cocok untuk menjalankan lokal.
VITE_BEDROCK_REGION=ap-southeast-1
# Isi dengan model ID atau inference profile yang AKTIF di akun Anda dan mendukung input dokumen PDF
# lewat Converse API (aktifkan akses model di konsol Bedrock lebih dulu).
VITE_BEDROCK_MODEL_ID=

# Kredensial AWS lokal (hanya jika BEDROCK_MODEL_ID diisi). Bisa juga memakai `aws configure` / AWS_PROFILE.
# VITE_AWS_ACCESS_KEY_ID=
# VITE_AWS_SECRET_ACCESS_KEY=

# Akun contoh di halaman login. Kata sandi semua akun contoh = DEMO_PASSWORD.
# Setel DEMO_MODE=off di produksi untuk menyembunyikan daftar akun dan kata sandi contoh.
VITE_DEMO_MODE=on
VITE_DEMO_PASSWORD=amiga2026
